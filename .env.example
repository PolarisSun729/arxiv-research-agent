# 开发模板；用 scripts/init_security.py --profile development 生成 .env 与私有签名文件。
# 公网用 --profile production --domain arxiv.001769.xyz 生成 .env.production（Redis、Origin 和代理配置独立）。
# 默认使用独立账号；签名密钥仅保留在后端，缺失或明显弱值会阻止启动。
AUTH_MODE=jwt
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# KEY 和 FILE 二选一；文件路径相对仓库根目录，Linux 权限必须为 0600。
JWT_SECRET_KEY=
JWT_SECRET_FILE=
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=arxiv-research-agent
JWT_AUDIENCE=arxiv-research-api
AUTH_DATABASE_PATH=backend/data/auth/auth.sqlite3
ALLOW_PUBLIC_REGISTRATION=false
AUTH_MAX_REQUEST_BYTES=1048576

# 开发地址；公网部署改为实际前端 HTTPS Origin，不含末尾斜杠。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1

# 供应商密钥仅供后端使用，必须与 JWT 签名密钥或兼容访问密钥分开生成。
ALIYUN_API_KEY=
BACKEND_SERVICE_LOAD_MODE=lazy
ENABLE_DEBUG_ROUTES=false
BACKEND_LOG_LEVEL=INFO
BACKEND_ACCESS_LOG=false

# 第二阶段：默认适合单进程开发；公网部署使用持久化 Redis，以共享限额并在重启后保留计数。
RATE_LIMIT_STORAGE=memory://
# RATE_LIMIT_STORAGE=redis://127.0.0.1:6379/0
# Docker Redis 与应用连接串必须使用同一独立密码；初始化脚本自动生成并写入，不要照抄示例密码。
REDIS_PASSWORD=
RATE_LIMIT_IP="60/minute;10/second"
RATE_LIMIT_USER=60/minute
# 登录/注册按来源 IP 共用预算，登录另按规范化账号限制跨 IP 的密码猜测。
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_LOGIN_ACCOUNT=10/minute
RATE_LIMIT_READ=60/minute
RATE_LIMIT_WRITE=20/minute
RATE_LIMIT_EXPENSIVE=5/minute
AUTH_FAILURE_LIMIT=20/minute
RATE_LIMIT_VIOLATION_LIMIT=30/minute
ABUSE_BLOCK_SECONDS=900

IP_FILTER_MODE=disabled
IP_BLACKLIST=
IP_WHITELIST=
# 经本机 Nginx 代理时设置 127.0.0.1,::1；直接运行时留空，不相信客户端自报的来源头。
TRUSTED_PROXY_IPS=

# 仅显式 AUTH_MODE=api_key 时使用以下兼容配置；共享密钥不提供独立用户身份。
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEYS=
RATE_LIMIT_KEY=60/minute
# 可选：按 backend/config/api_keys.example.json 创建私有配置，路径相对仓库根目录。
API_KEY_CONFIG_FILE=
# RESEARCH_TEAM_ACCESS_KEY=

AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=logs/audit.log
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=5

# 使用在线 arXiv 时无需本地 OAI 镜像；有本地镜像时可改为 local。
ARXIV_DATA_SOURCE=api
ARXIV_PROXY_URL=

# Docker MinIO 与 Milvus 必须加载同一份环境文件；空值会阻止 Compose 启动，不能退回公开默认密码。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
