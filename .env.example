# =====================================================================
# 后端环境变量模板（唯一进 Git 的配置文件）
# ---------------------------------------------------------------------
# 不要手工复制本文件，用初始化脚本生成，密钥会自动随机生成并单独保存：
#   开发：python scripts/init_security.py --profile development
#         -> 生成 .env 与 backend/config/development.jwt-secret
#   公网：python scripts/init_security.py --profile production --domain arxiv.001769.xyz
#         -> 生成 .env.production 与 backend/config/production.jwt-secret
#            （Redis 限流、HTTPS Origin、Nginx 代理、并发预算与开发环境不同）
# 加载顺序：进程环境变量 > 根目录 .env > backend/.env，已存在的变量不会被覆盖。
# 服务器上由 systemd 的 EnvironmentFile 读取 shared/.env.production。
# 密钥缺失或强度明显不足时后端拒绝启动，不会退回到不安全的默认值。
# =====================================================================


# ---------------------------------------------------------------------
# 认证（JWT 账号体系）
# ---------------------------------------------------------------------
# 认证方式：jwt = 独立用户账号登录（推荐）；api_key = 旧的共享访问密钥兼容模式（见下方“API Key 兼容模式”）。
AUTH_MODE=jwt
# JWT 签名密钥，KEY 和 FILE 二选一，同时设置会拒绝启动。
#   JWT_SECRET_KEY：直接写密钥，生成方式 python -c "import secrets; print(secrets.token_urlsafe(48))"
#   JWT_SECRET_FILE：密钥文件路径（相对仓库根目录），初始化脚本默认用这种方式；Linux 下文件权限必须为 0600。
# 换密钥会让所有已登录用户的 token 立即失效。
JWT_SECRET_KEY=
JWT_SECRET_FILE=
# 登录 token 有效期（分钟），过期需重新登录；上限 1440（一天）。
JWT_EXPIRE_MINUTES=60
# 写入 token 的签发方 / 受众标识，校验时必须一致；一般不用改，改了旧 token 全部失效。
JWT_ISSUER=arxiv-research-agent
JWT_AUDIENCE=arxiv-research-api
# 用户账号 SQLite 数据库路径；开发和生产各用一份，账号互不相通。用 scripts/manage_users.py 创建管理员。
AUTH_DATABASE_PATH=backend/data/auth/auth.sqlite3
# 是否允许任何人在前端自助注册；false 时只能由管理员用 manage_users.py 建号。
ALLOW_PUBLIC_REGISTRATION=false
# 认证后接口单个请求体的最大字节数（默认 1 MiB），需与 deploy/nginx.conf 的 client_max_body_size 保持一致。
AUTH_MAX_REQUEST_BYTES=1048576


# ---------------------------------------------------------------------
# 服务监听与跨域
# ---------------------------------------------------------------------
# 允许跨域访问 API 的前端 Origin，逗号分隔，需写完整协议+主机(+端口)，不含末尾斜杠、通配符或路径。
# 开发为 Vite 地址；公网改为实际前端 HTTPS 域名，如 https://arxiv.001769.xyz。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 后端监听地址。127.0.0.1 只接受本机连接（公网由 Nginx 反代）；改成 0.0.0.0 会把后端直接暴露出去。
BACKEND_HOST=127.0.0.1


# ---------------------------------------------------------------------
# 模型供应商与运行行为
# ---------------------------------------------------------------------
# 阿里云百炼（DashScope）API Key，LLM 与 Embedding 默认都用它；只在后端使用，绝不下发给浏览器。
# 必须与 JWT 密钥、访问密钥分开，不能复用同一个值。初始化脚本不会生成它，需要手动填写。
ALIYUN_API_KEY=
# 后端服务（向量库、模型客户端等）的加载时机：
#   lazy    = 第一次用到时再初始化，启动快，首个请求稍慢（开发推荐）
#   preload = 启动时全部初始化，启动慢但能尽早暴露配置问题（变量未设置时代码默认 preload）
BACKEND_SERVICE_LOAD_MODE=lazy
# 是否注册调试路由（如 PDF 分块查看接口），会暴露内部解析产物，生产环境必须为 false。
ENABLE_DEBUG_ROUTES=false
# 后端日志级别：DEBUG / INFO / WARNING / ERROR。
BACKEND_LOG_LEVEL=INFO
# 是否打印每个 HTTP 请求的访问日志；默认关闭，避免前端轮询刷屏淹没业务日志。
BACKEND_ACCESS_LOG=false


# ---------------------------------------------------------------------
# 限流
# ---------------------------------------------------------------------
# 规则格式："次数/时间单位"，单位可选 second / minute / hour / day；多条规则用分号连接，需同时满足，
# 例如 "60/minute;10/second"。含分号的值要加引号。

# 限流计数存储位置：
#   memory://  = 存在进程内存，单进程开发够用，重启即清零，多 worker 之间不共享
#   redis://:<密码>@127.0.0.1:6379/0 = 存在 Redis，多进程共享、重启不丢（公网必须用）
# Redis 不可用时请求会直接返回 503，不会悄悄退回内存计数。
RATE_LIMIT_STORAGE=memory://
# RATE_LIMIT_STORAGE=redis://127.0.0.1:6379/0
# docker-compose 启动 Redis 时使用的密码，必须与 RATE_LIMIT_STORAGE 里的密码一致。
# 初始化脚本会自动生成并同时写入两处，不要照抄示例密码。
REDIS_PASSWORD=
# 每个来源 IP 的总请求上限，在认证之前检查（挡住未登录的扫描流量）。
RATE_LIMIT_IP="60/minute;10/second"
# 每个已登录用户（按 user_id 计，不随 token 或 IP 变化）的总请求上限。
RATE_LIMIT_USER=60/minute
# 登录 / 注册接口按来源 IP 的共用上限。
RATE_LIMIT_AUTH=10/minute
# 登录接口按用户名（不分大小写）的上限，防止换 IP 对同一账号猜密码。
RATE_LIMIT_LOGIN_ACCOUNT=10/minute
# 已认证请求还会按操作类型再限一次（与 RATE_LIMIT_USER 同时生效）：
#   READ      = GET 类读取接口及 arXiv 搜索
#   WRITE     = 其余普通写操作
#   EXPENSIVE = 会调用 LLM / 下载 PDF / 建索引 / 生成向量的重操作（Agent 对话、论文问答、推荐、建 QA 索引等）
RATE_LIMIT_READ=60/minute
RATE_LIMIT_WRITE=20/minute
RATE_LIMIT_EXPENSIVE=5/minute
# 单个 IP 认证失败（缺 token、token 无效、密码错误等）超过此频率就临时封禁该 IP。
AUTH_FAILURE_LIMIT=20/minute
# 单个 IP 被限流拒绝（429）超过此频率就临时封禁该 IP。
RATE_LIMIT_VIOLATION_LIMIT=30/minute
# 上面两种情况触发后的封禁时长（秒），封禁期间该 IP 所有请求返回 403；默认 900 秒 = 15 分钟。
ABUSE_BLOCK_SECONDS=900


# ---------------------------------------------------------------------
# IP 过滤与代理
# ---------------------------------------------------------------------
# IP 过滤模式：disabled = 不过滤；blacklist = 拒绝 IP_BLACKLIST 中的地址；whitelist = 只允许 IP_WHITELIST 中的地址。
IP_FILTER_MODE=disabled
# 黑 / 白名单，逗号分隔，支持单个 IP 或 CIDR 网段（如 10.0.0.0/8）。whitelist 模式下白名单不能为空。
IP_BLACKLIST=
IP_WHITELIST=
# 可信反向代理地址。只有请求来自这些地址时，才读取 X-Forwarded-For 等头作为真实客户端 IP。
# 经本机 Nginx 代理时设置 127.0.0.1,::1；直接运行时留空，否则客户端可以伪造来源 IP 绕过限流。
TRUSTED_PROXY_IPS=


# ---------------------------------------------------------------------
# API Key 兼容模式（仅 AUTH_MODE=api_key 时生效，JWT 模式下可忽略）
# ---------------------------------------------------------------------
# 共享访问密钥，逗号分隔，每个 32~256 个可打印字符；所有持有者共用同一身份，无法区分具体用户。
# 生成方式 python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEYS=
# 每个访问密钥的默认请求上限；密钥配置文件里可以按密钥单独覆盖，并设置每日配额和过期时间。
RATE_LIMIT_KEY=60/minute
# 可选：按 backend/config/api_keys.example.json 创建私有密钥配置文件（路径相对仓库根目录），
# 可以给每个密钥单独命名、限流、设置每日配额、禁用或设置过期时间。留空时若存在 backend/config/api_keys.json 则自动使用它。
API_KEY_CONFIG_FILE=
# api_keys.example.json 中示例密钥通过 key_env 引用的环境变量，使用密钥配置文件时再取消注释并填写。
# RESEARCH_TEAM_ACCESS_KEY=


# ---------------------------------------------------------------------
# 审计日志（记录谁在什么时间调用了哪个接口、结果如何，密钥会脱敏）
# ---------------------------------------------------------------------
# 是否启用审计日志。
AUDIT_LOG_ENABLED=true
# 审计日志写入位置：文件路径（相对仓库根目录），或 "-" 表示输出到 stdout（由 systemd / docker 统一收集）。
AUDIT_LOG_FILE=logs/audit.log
# 单个审计日志文件的最大字节数（默认 10 MiB），超过后轮转；输出到 stdout 时不生效。
AUDIT_LOG_MAX_BYTES=10485760
# 轮转时保留的历史文件个数。
AUDIT_LOG_BACKUP_COUNT=5


# ---------------------------------------------------------------------
# arXiv 数据源
# ---------------------------------------------------------------------
# 论文元数据来源：api = 在线调用 arXiv API（无需本地数据）；local = 使用本地 OAI 元数据镜像（变量未设置时代码默认 local）。
ARXIV_DATA_SOURCE=api
# 访问 arXiv 时使用的 HTTP 代理，如 http://127.0.0.1:7897；留空表示直连。
ARXIV_PROXY_URL=


# ---------------------------------------------------------------------
# 对象存储（MinIO，供 Milvus 使用）
# ---------------------------------------------------------------------
# MinIO 管理员账号和密码；docker-compose 启动 MinIO 和 Milvus 时都读取这两个值，
# 二者必须加载同一份环境文件。为空时 Compose 拒绝启动，不会退回 MinIO 的公开默认密码。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=


# ---------------------------------------------------------------------
# 并发与 PDF 解析（以下为代码默认值；公网配置会调低并发以适配小规格服务器）
# ---------------------------------------------------------------------
# 构建论文问答索引时，按分块并行调用 LLM 的线程数；调大更快，但更容易触发模型供应商限流。
PAPER_QA_BUILD_LLM_MAX_WORKERS=4
# 生成用户研究画像证据卡片时并行调用 LLM 的线程数。
PROFILE_EVIDENCE_MAX_WORKERS=2
# 一次检索中多路召回（向量改写、HyDE、关键词、表格等）并行执行的线程数。
RETRIEVAL_ROUTE_MAX_WORKERS=4
# Docling 解析 PDF 时是否启用 OCR；扫描版论文需要开启，但会显著增加 CPU 和耗时。
DOCLING_OCR_ENABLED=false
# 是否为每一页生成页面截图（用于前端定位原文位置）。
DOCLING_GENERATE_PAGE_IMAGES=true
# 是否把论文中的图片 / 图表单独导出为图片。
DOCLING_GENERATE_PICTURE_IMAGES=true
# 页面截图和图片的渲染倍率；越大越清晰，但内存和磁盘占用按平方增长。
DOCLING_IMAGES_SCALE=2.0
